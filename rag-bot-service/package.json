{
  "name": "rag-bot-service",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-Tenant Retrieval-Augmented Generation (RAG) Service and API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/modules/ingestion/local-worker.ts",
    "db:migrate": "tsx src/adapters/database/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "package:lambda": "tsx scripts/package-lambda.ts"
  },
  "keywords": [
    "rag",
    "nestjs",
    "typescript",
    "aws-lambda",
    "pgvector",
    "multi-tenant"
  ],
  "author": "PersonaRAG Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/client-sqs": "^3.670.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@types/multer": "^1.4.13",
    "dotenv": "^16.4.5",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.7.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.24.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
