# Application & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

AUTH_SECRET=your-secret-token-change-in-prod
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag-bot
DB_POOL_MAX=10
DB_USE_SSL=false

# Storage Adapter: "local" or "s3"
STORAGE_ADAPTER=local
LOCAL_STORAGE_DIR=./data/storage
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# Queue Adapter: "local" or "sqs"
QUEUE_ADAPTER=local
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-queue

# AI Provider Configuration: "gemini", "openai", "cohere", or "mock"
AI_PROVIDER=gemini

# Google Gemini (OpenAI-Compatible Endpoint)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Secondary / Fallback Providers
OPENAI_API_KEY=your-openai-api-key
COHERE_API_KEY=your-cohere-api-key

# Ingestion & Chunking Settings
MAX_FILE_SIZE_BYTES=26214400 # 25MB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INGESTION_MAX_RETRIES=3

# RAG & Retrieval Settings
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_SCORE=0.01
MAX_HISTORY_MESSAGES=10
